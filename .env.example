# Copy to .env on the VPS and fill in. Never commit .env.

# Host paths used by compose.yaml (not read by the app itself).
SNAPSHOT_HOST_DIR=/srv/interview-project-agent/snapshot
DATA_HOST_DIR=/srv/interview-project-agent/data

# Access control: at least one of these must be non-empty (comma-separated).
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=

# LLM provider: openai (default, gpt-6-luna) or anthropic (claude-haiku-5-5).
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Magic-code email via SMTP with STARTTLS (Gmail App Password, not a personal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Interview Project Agent

# Optional overrides (defaults shown).
# LISTEN_ADDR=:8080
# CODE_TTL=10m
# SESSION_TTL=12h
# CODE_REQUESTS_PER_IP_HOUR=10
# CODE_REQUESTS_PER_EMAIL_HOUR=3
# VERIFY_ATTEMPTS_PER_CODE=5
# CHAT_PER_SESSION_MINUTE=6
# CHAT_PER_IP_MINUTE=12
# MAX_MESSAGE_CHARS=2000
# SESSION_TURN_CAP=40
# TOOL_STEP_CAP=6
